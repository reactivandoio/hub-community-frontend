# Desenvolvimento em Docker (REA-21). O make dev copia este arquivo para .env.dev (fora do git).
# Sem segredo nenhum aqui. Dentro do container o .env é o .env.dev; o .env da máquina não é lido.

# BFF que o frontend usa. Padrão: o BFF local (make dev no hub-community-bff, porta 4001).
# BFF_URL é o endereço que o navegador usa; BFF_SERVER_URL, o que o servidor do Next usa de
# dentro do container. Para usar o BFF de produção (com a sua conta de verdade), use as duas
# linhas comentadas ou rode: make dev BFF=prod
BFF_URL=http://localhost:4001/graphql
BFF_SERVER_URL=http://host.docker.internal:4001/graphql
# BFF_URL=https://bff.hubcommunity.io/graphql
# BFF_SERVER_URL=https://bff.hubcommunity.io/graphql

NEXT_PUBLIC_SITE_URL=http://localhost:4010

# Upload de imagens no admin (rota /api/upload) vai direto ao Strapi do Hub.
# Local: make dev no hub-community-backend. Token: admin do Strapi -> Settings -> API Tokens.
MANAGER_URL=http://host.docker.internal:1340
MANAGER_TOKEN=

# Firebase só serve para o Analytics; vazio, o analytics fica desligado.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Se a recarga de código não pegar alterações (alguns setups de macOS), ligue o polling:
# WATCHPACK_POLLING=true
